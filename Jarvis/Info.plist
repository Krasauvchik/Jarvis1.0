<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Плавная анимация на ProMotion (120 Hz), по аналогии с Task-Sync-Pro -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- iOS / macOS privacy usage descriptions -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Микрофон используется для голосового ввода задач и напоминаний.</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Распознавание речи используется для преобразования вашего голоса в задачи и напоминания.</string>

	<key>NSCalendarsUsageDescription</key>
	<string>Доступ к календарю нужен для синхронизации задач Jarvis с приложением Календарь.</string>

	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Jarvis отображает ваши события из локального календаря вместе с Google Calendar.</string>

	<key>NSRemindersUsageDescription</key>
	<string>Доступ к напоминаниям нужен для синхронизации задач Jarvis с приложением Напоминания.</string>

	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Jarvis синхронизирует ваши напоминания для отображения и управления задачами.</string>

	<key>NSFaceIDUsageDescription</key>
	<string>Face ID используется для защиты доступа к приложению Jarvis.</string>

	<!-- macOS: уведомления через UNUserNotificationCenter -->
	<key>NSUserNotificationUsageDescription</key>
	<string>Уведомления используются для напоминаний и будильников планнера.</string>

	<!-- Deep Linking URL Scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jarvis.planner</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jarvis</string>
			</array>
		</dict>
	</array>

	<!--
	  App Transport Security: enforce HTTPS for all remote traffic (personal data).
	  We do NOT grant plaintext-HTTP exceptions to the production backend — it must be
	  reached over TLS. The only relaxation is NSAllowsLocalNetworking, which permits
	  connections to local hosts (localhost / *.local / link-local) for the on-device
	  Ollama model, without weakening security for any public endpoint.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Local network for Ollama LLM -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Jarvis подключается к локальной языковой модели Ollama для AI-функций.</string>

	<!-- App Store category -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
</dict>
</plist>
